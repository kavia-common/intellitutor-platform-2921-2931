# Backend environment variables for IntelliTutor Chatbot Backend
ENVIRONMENT=development

# LLM Provider settings (openai|anthropic or mock if missing)
LLM_PROVIDER=openai
LLM_API_KEY=YOUR_API_KEY_HERE
LLM_MODEL=gpt-4o-mini

# Retrieval settings
RAG_ENABLED=true
RAG_TOP_K=4
KNOWLEDGE_DIR=knowledge_base

# Persistence layer (memory for demo)
PERSISTENCE=memory

# CORS
CORS_ALLOW_ORIGINS=*
