# Runtime environment
ENVIRONMENT=development

# LLM provider configuration (choose: openai, anthropic, mock)
LLM_PROVIDER=openai
# Preferred model for the selected provider
LLM_MODEL=gpt-4o-mini
# API keys - set only one based on provider being used
# Orchestrator will fallback to MOCK responses if not provided.
LLM_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Retrieval / RAG
RAG_ENABLED=true
RAG_TOP_K=4
# Directory for the knowledge base files
KNOWLEDGE_DIR=knowledge_base

# Persistence layer (memory is the default starter)
PERSISTENCE=memory

# CORS configuration (comma-separated origins or * for all)
CORS_ALLOW_ORIGINS=*
